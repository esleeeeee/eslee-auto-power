<controls:ThemedWindow x:Class="AutoPower.App.ProgramEditorWindow"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:controls="clr-namespace:AutoPower.App.Controls"
                       Title="후속 프로그램 추가"
                       Width="600"
                       Height="600"
                       MinWidth="520"
                       MinHeight="440"
                       WindowStartupLocation="CenterOwner"
                       ShowInTaskbar="False"
                       AllowDrop="True"
                       DragOver="Window_DragOver"
                       Drop="Window_Drop">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,24,28,24">
                <TextBlock x:Name="Heading" Text="후속 프로그램" Style="{DynamicResource SubtitleText}" />
                <TextBlock Text="절전·최대 절전에서 깨어나 바탕화면이 준비된 시점(T0)을 기준으로 실행합니다. EXE 파일을 이 창으로 끌어다 놓아도 됩니다."
                           Style="{DynamicResource SecondaryText}" Margin="0,6,0,20" />

                <TextBlock Text="프로그램 경로" Style="{DynamicResource FieldLabel}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PathInput" AutomationProperties.Name="프로그램 경로" />
                    <Button Grid.Column="1" Content="찾아보기" Margin="8,0,0,0" Click="BrowseProgram_Click" />
                </Grid>

                <TextBlock Text="바탕화면 준비 후 N분 (0 이상)" Style="{DynamicResource FieldLabel}" Margin="0,16,0,6" />
                <TextBox x:Name="DelayInput" Text="0" Width="120" HorizontalAlignment="Left" AutomationProperties.Name="바탕화면 준비 후 N분 (0 이상)" />

                <Expander x:Name="AdvancedOptions" Header="고급 옵션" Margin="0,20,0,0">
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="실행 인수" Style="{DynamicResource FieldLabel}" />
                        <TextBox x:Name="ArgumentsInput" AutomationProperties.Name="실행 인수" />
                        <TextBlock Text="작업 폴더" Style="{DynamicResource FieldLabel}" Margin="0,14,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="WorkingDirectoryInput" AutomationProperties.Name="작업 폴더" />
                            <Button Grid.Column="1" Content="찾아보기" Margin="8,0,0,0" Click="BrowseFolder_Click" AutomationProperties.Name="작업 폴더 찾아보기" />
                        </Grid>
                        <CheckBox x:Name="RunElevatedCheck" Content="관리자 권한으로 실행" Margin="0,18,0,6" />
                        <Border Style="{DynamicResource InfoBarCaution}">
                            <TextBlock Style="{DynamicResource BodyText}" Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="선택하면 예약 저장 시 승인된 Windows 작업을 미리 등록합니다. 실제 실행 시에는 UAC 확인창 없이 현재 사용자 데스크톱에서 최고 권한으로 시작됩니다. 신뢰할 수 있는 프로그램에만 사용하세요." />
                        </Border>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Style="{DynamicResource DialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SaveButton" Content="추가" MinWidth="96" Style="{DynamicResource AccentButton}" IsDefault="True" Margin="0,0,8,0" Click="Add_Click" />
                <Button Content="취소" MinWidth="96" IsCancel="True" />
            </StackPanel>
        </Border>
    </Grid>
</controls:ThemedWindow>
