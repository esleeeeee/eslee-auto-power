<Window x:Class="AutoPower.App.ProgramEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="후속 프로그램 추가" Width="610" Height="620" MinWidth="560" MinHeight="460"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,0">
            <TextBlock Text="후속 프로그램" FontSize="21" FontWeight="SemiBold"/>
            <TextBlock Text="실제 바탕화면 준비 완료 시점 T0를 기준으로 실행합니다." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,16"/>
            <TextBlock Text="프로그램 경로" Margin="0,0,0,5"/>
            <DockPanel><Button Content="찾아보기" DockPanel.Dock="Right" Click="BrowseProgram_Click" Margin="8,0,0,0"/><TextBox x:Name="PathInput"/></DockPanel>
            <TextBlock Text="바탕화면 준비 후 N분 (0 이상)" Margin="0,14,0,5"/>
            <TextBox x:Name="DelayInput" Text="0" Width="120" HorizontalAlignment="Left"/>
            <Expander x:Name="AdvancedOptions" Header="고급 옵션" Margin="0,16,0,0" Foreground="{StaticResource TextBrush}">
                <StackPanel Margin="0,10,0,0">
                    <TextBlock Text="실행 인수" Margin="0,0,0,5"/><TextBox x:Name="ArgumentsInput"/>
                    <TextBlock Text="작업 폴더" Margin="0,12,0,5"/>
                    <DockPanel><Button Content="찾아보기" DockPanel.Dock="Right" Click="BrowseFolder_Click" Margin="8,0,0,0"/><TextBox x:Name="WorkingDirectoryInput"/></DockPanel>
                    <CheckBox x:Name="RunElevatedCheck" Content="관리자 권한으로 실행" Margin="0,16,0,5"/>
                    <TextBlock Text="선택하면 예약 저장 시 승인된 Windows 작업을 미리 등록합니다. 실제 실행 시에는 UAC 확인창 없이 현재 사용자 데스크톱에서 최고 권한으로 시작됩니다. 신뢰할 수 있는 프로그램에만 사용하세요."
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Expander>
        </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="취소" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="추가" Style="{StaticResource AccentButton}" Click="Add_Click"/>
        </StackPanel>
    </Grid>
</Window>
