<controls:ThemedWindow x:Class="AutoPower.App.WelcomeWindow"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:controls="clr-namespace:AutoPower.App.Controls"
                       Title="eslee Auto Power 시작"
                       Width="560"
                       SizeToContent="Height"
                       ResizeMode="NoResize"
                       WindowStartupLocation="CenterOwner"
                       ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="28,24,28,24">
            <StackPanel Orientation="Horizontal">
                <Image Source="pack://application:,,,/AutoPower.App;component/Assets/eslee-auto-power.png"
                       Width="40"
                       Height="40"
                       Margin="0,0,14,0"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="eslee Auto Power" Style="{DynamicResource SubtitleText}" />
                    <TextBlock Text="Windows 11 전원 자동화를 시작합니다" Style="{DynamicResource SecondaryText}" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <Border Style="{DynamicResource Card}" Margin="0,20,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static controls:Glyphs.Power}" Style="{DynamicResource IconText}" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Top" Margin="0,2,12,0" />
                        <TextBlock Grid.Column="1" Style="{DynamicResource BodyText}"
                                   Text="정해진 시각에 PC를 완전 종료하거나 최대 절전·절전 상태로 전환합니다. 매일·평일·요일 반복도 고를 수 있습니다." />
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static controls:Glyphs.Wake}" Style="{DynamicResource IconText}" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Top" Margin="0,2,12,0" />
                        <TextBlock Grid.Column="1" Style="{DynamicResource BodyText}"
                                   Text="절전(S3)이나 최대 절전(S4) 상태의 PC를 예약 시각에 깨우고, 복귀가 끝나면 지정한 프로그램을 실행합니다." />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static controls:Glyphs.Shield}" Style="{DynamicResource IconText}" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Top" Margin="0,2,12,0" />
                        <TextBlock Grid.Column="1" Style="{DynamicResource BodyText}"
                                   Text="예약과 기록은 이 PC에만 저장되며 외부 서버로 사용 정보를 보내지 않습니다." />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Style="{DynamicResource SecondaryText}" Margin="0,16,0,0"
                       Text="먼저 호환성 화면에서 이 PC가 어떤 자동 시작 방식을 지원하는지 확인하는 것을 권장합니다." />
        </StackPanel>

        <Border Grid.Row="1" Style="{DynamicResource DialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="나중에" MinWidth="96" Margin="0,0,8,0" IsCancel="True" Click="Later_Click" />
                <Button Content="호환성 확인" MinWidth="96" Style="{DynamicResource AccentButton}" IsDefault="True" Click="Start_Click" />
            </StackPanel>
        </Border>
    </Grid>
</controls:ThemedWindow>
