<Window x:Class="AutoPower.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="eslee Auto Power" Width="1000" Height="700" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#111419" BorderBrush="#2E3640" BorderThickness="0,0,1,0">
            <Grid Margin="18">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="4,8,0,28">
                    <TextBlock Text="eslee" FontSize="14" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                    <TextBlock Text="Auto Power" FontSize="24" FontWeight="SemiBold" Margin="0,2,0,0"/>
                    <TextBlock Text="Windows 11 전원 자동화" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <Button Content="예약" Click="Reservations_Click" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
                    <Button Content="기록" Click="History_Click" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
                    <Button x:Name="SettingsNavigationButton" Content="설정" Click="Settings_Click" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
                    <Button x:Name="CompatibilityNavigationButton" Content="호환성" Click="Compatibility_Click" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
                    <Button x:Name="AboutButton" Content="정보" Click="About_Click" HorizontalContentAlignment="Left"/>
                </StackPanel>
                <Border Grid.Row="3" Background="#1B2027" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="다음 예약" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                        <TextBlock Text="{Binding NextScheduleSummary}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="0" Background="{StaticResource WindowBrush}">
          <Grid Margin="28,22,28,22">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,18">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock x:Name="PageTitle" Text="예약" FontSize="27" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PageSubtitle" Text="통합 자동 시작 예약과 전원 동작" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusMessage}" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right"/>
            </DockPanel>
            <Border Grid.Row="1" Background="#4A2029" BorderBrush="#8E394B" BorderThickness="1" CornerRadius="7" Padding="12"
                    Margin="0,0,0,14" Visibility="{Binding HasSecurityWarning, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                <TextBlock Text="{Binding SecurityWarning}" Foreground="#FFD8DE" TextWrapping="Wrap"/>
            </Border>

            <TabControl x:Name="Pages" Grid.Row="2" SelectedIndex="0" Background="{StaticResource WindowBrush}" BorderThickness="0">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <Border Background="{StaticResource WindowBrush}">
                            <ContentPresenter Content="{TemplateBinding SelectedContent}" ContentTemplate="{TemplateBinding SelectedContentTemplate}"/>
                        </Border>
                    </ControlTemplate>
                </TabControl.Template>
                <TabItem Foreground="{StaticResource TextBrush}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Background="#3A3020" BorderBrush="#7A6230" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="자동 시작 예약과 전원 상태 전환" FontWeight="SemiBold" Foreground="#FFE1A0"/>
                                <TextBlock Text="S3/S4 버튼을 누르면 같은 방식의 자동 시작 예약을 준비한 뒤 PC를 해당 전원 상태로 전환합니다. 예약이 없으면 바로 전환합니다."
                                           Foreground="#E8C982" TextWrapping="Wrap" Margin="0,5,0,10"/>
                                <WrapPanel>
                                    <Button Content="지금 S3 절전" Style="{StaticResource AccentButton}" Click="EnterS3_Click" Margin="0,0,8,8"/>
                                    <Button Content="지금 S4 최대 절전" Click="EnterS4_Click" Margin="0,0,0,8"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <DockPanel Grid.Row="1" Margin="0,0,0,12">
                            <Button Content="+ 새 예약" Style="{StaticResource AccentButton}" Click="New_Click" DockPanel.Dock="Left" Margin="0,0,8,0"/>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                <Button Content="수정" Click="Edit_Click" Margin="0,0,8,0"/>
                                <Button Content="ON / OFF" Click="Toggle_Click" Margin="0,0,8,0"/>
                                <Button Content="삭제" Click="Delete_Click"/>
                            </StackPanel>
                        </DockPanel>
                        <DataGrid Grid.Row="2" ItemsSource="{Binding Schedules}" SelectedItem="{Binding SelectedSchedule}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="날짜" Binding="{Binding DateText}" Width="145"/>
                                <DataGridTextColumn Header="시간" Binding="{Binding TimeText}" Width="75"/>
                                <DataGridTextColumn Header="예약 종류" Binding="{Binding ActionText}" Width="155"/>
                                <DataGridTextColumn Header="상태" Binding="{Binding EnabledText}" Width="65"/>
                                <DataGridTextColumn Header="세션" Binding="{Binding SessionText}" Width="125"/>
                                <DataGridTextColumn Header="후속 프로그램" Binding="{Binding ProgramsText}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
                <TabItem Foreground="{StaticResource TextBrush}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Button Content="전체 기록 삭제" HorizontalAlignment="Right" Click="ClearHistory_Click" Margin="0,0,0,12"/>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding History}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="시각" Binding="{Binding TimeText}" Width="155"/>
                                <DataGridTextColumn Header="구분" Binding="{Binding History.EventType}" Width="150"/>
                                <DataGridTextColumn Header="결과" Binding="{Binding ResultText}" Width="85"/>
                                <DataGridTextColumn Header="내용" Binding="{Binding DetailText}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
                <TabItem Foreground="{StaticResource TextBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="700" HorizontalAlignment="Left">
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="Windows 시작" FontSize="17" FontWeight="SemiBold"/>
                                    <CheckBox x:Name="StartupCheck" Content="Windows 로그인 시 eslee Auto Power 시작" Margin="0,14,0,6" Click="StartupCheck_Click"/>
                                    <TextBlock Text="끄면 일부 알림, 후속 프로그램 실행 상태 표시 및 복구 기능이 제한될 수 있습니다. 등록된 전원 작업 자체는 유지됩니다."
                                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                    <Button Content="진단 로그 폴더 열기" HorizontalAlignment="Left" Margin="0,16,0,0" Click="OpenLogs_Click"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="20" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="S3/S4 앱 관리형 1회 자동 로그인" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock Text="자동 시작 예약에서 1회 자동 로그인을 선택할 때 사용할 Windows 계정을 등록하고 실제 로그온 자격 증명을 검사합니다. PIN이 아니라 Windows 계정 암호를 입력하세요. 암호는 Windows 보호 저장소에만 보관됩니다."
                                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                    <TextBlock x:Name="CredentialStatusText" Text="등록 상태 확인 중…" Foreground="{StaticResource AccentBrush}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="Windows 사용자 이름" Margin="0,14,0,6"/>
                                    <TextBox x:Name="CredentialUserNameInput"/>
                                    <TextBlock Text="Windows 계정 암호" Margin="0,12,0,6"/>
                                    <PasswordBox x:Name="CredentialPasswordInput"/>
                                    <TextBlock Text="Microsoft 계정은 메일 주소만 입력해도 MicrosoftAccount\메일주소 형식으로 자동 변환됩니다. 로컬 계정은 PC이름\사용자 형식이며, Windows Hello PIN은 사용할 수 없습니다."
                                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                    <WrapPanel Margin="0,14,0,0">
                                        <Button Content="저장 및 검증" Style="{StaticResource AccentButton}" Click="SaveCredential_Click" Margin="0,0,8,8"/>
                                        <Button Content="저장된 로그인 테스트" Click="TestCredential_Click" Margin="0,0,8,8"/>
                                        <Button Content="등록 정보 제거" Click="RemoveCredential_Click" Margin="0,0,0,8"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Foreground="{StaticResource TextBrush}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Button Content="다시 진단" HorizontalAlignment="Right" Click="Diagnose_Click" Margin="0,0,0,12"/>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Compatibility}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  RowHeight="NaN" MinRowHeight="52" HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="기능" Width="165" MinWidth="145">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CapabilityText}" TextWrapping="Wrap" TextTrimming="None"
                                                       VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="상태" Width="190" MinWidth="165">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" TextTrimming="None"
                                                       VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="세부 정보" Width="*" MinWidth="220">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DetailText}" TextWrapping="Wrap" TextTrimming="None"
                                                       VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="16" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="전원 자동 깨우기 실제 테스트" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="MVP 자동 시작 경로인 S3 절전과 S4 최대 절전의 WakeToRun 동작을 직접 검증합니다."
                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,12"/>
                                <WrapPanel HorizontalAlignment="Left">
                                    <Button Content="S3 절전 테스트" Click="S3Test_Click" Margin="0,0,8,8"/>
                                    <Button Content="S4 최대 절전 테스트" Click="S4Test_Click" Margin="0,0,8,8"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
            <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}" Margin="0,13,0,0"/>
          </Grid>
        </Grid>
    </Grid>
</Window>
