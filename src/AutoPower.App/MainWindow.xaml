<controls:ThemedWindow x:Class="AutoPower.App.MainWindow"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:core="clr-namespace:AutoPower.Core;assembly=AutoPower.Core"
                       xmlns:controls="clr-namespace:AutoPower.App.Controls"
                       xmlns:app="clr-namespace:AutoPower.App"
                       Title="eslee Auto Power"
                       Width="1120"
                       Height="740"
                       MinWidth="900"
                       MinHeight="600"
                       WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- Round action icon of list items and the detail header. -->
        <Style x:Key="ActionIconCircle" TargetType="Border">
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                    <Setter Property="Background" Value="{DynamicResource NeutralBadgeBackgroundBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource NeutralBadgeForegroundBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ResultBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource NeutralBadgeBackgroundBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource NeutralBadgeForegroundBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Result}" Value="{x:Static core:ResultKind.Success}">
                    <Setter Property="Background" Value="{DynamicResource SuccessBackgroundBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource SuccessForegroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Result}" Value="{x:Static core:ResultKind.Failure}">
                    <Setter Property="Background" Value="{DynamicResource CriticalBackgroundBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource CriticalForegroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Result}" Value="{x:Static core:ResultKind.Warning}">
                    <Setter Property="Background" Value="{DynamicResource CautionBackgroundBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource CautionForegroundBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CapabilityBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource NeutralBadgeBackgroundBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource NeutralBadgeForegroundBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static core:CapabilityStatus.Confirmed}">
                    <Setter Property="Background" Value="{DynamicResource SuccessBackgroundBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource SuccessForegroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static core:CapabilityStatus.NeedsPhysicalTest}">
                    <Setter Property="Background" Value="{DynamicResource CautionBackgroundBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource CautionForegroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static core:CapabilityStatus.UnsupportedOrFailed}">
                    <Setter Property="Background" Value="{DynamicResource CriticalBackgroundBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource CriticalForegroundBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DetailLabel" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
            <Setter Property="Margin" Value="16,11,12,11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="DetailValue" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="Margin" Value="0,11,16,11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="RowDivider" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Grid.ColumnSpan" Value="2" />
        </Style>

        <ContextMenu x:Key="ScheduleContextMenu">
            <MenuItem Header="수정" Click="EditMenu_Click">
                <MenuItem.Icon><TextBlock Text="{x:Static controls:Glyphs.Edit}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="복제" Click="DuplicateMenu_Click">
                <MenuItem.Icon><TextBlock Text="{x:Static controls:Glyphs.Copy}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{Binding ToggleMenuText}" Click="ToggleMenu_Click">
                <MenuItem.Icon><TextBlock Text="{x:Static controls:Glyphs.Pause}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="기록 보기" Click="ScheduleHistoryMenu_Click">
                <MenuItem.Icon><TextBlock Text="{x:Static controls:Glyphs.History}" /></MenuItem.Icon>
            </MenuItem>
            <Separator Margin="4" />
            <MenuItem Header="삭제" Click="DeleteMenu_Click">
                <MenuItem.Icon><TextBlock Text="{x:Static controls:Glyphs.Delete}" /></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <DataTemplate x:Key="ScheduleItemTemplate" DataType="{x:Type app:ScheduleRow}">
            <Grid Background="Transparent" ContextMenu="{StaticResource ScheduleContextMenu}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center" Style="{StaticResource ActionIconCircle}">
                    <TextBlock Text="{Binding ActionGlyph}" FontFamily="{x:Static controls:ThemeFonts.Icons}" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding TimeText}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DateText}" Margin="8,2,0,0" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock Text="{Binding TitleText}" FontSize="13" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Margin="0,1,0,0"
                                Visibility="{Binding IsRecurring, Converter={x:Static controls:Converters.BoolToVisibility}}">
                        <TextBlock Text="{x:Static controls:Glyphs.Repeat}" FontFamily="{x:Static controls:ThemeFonts.Icons}" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,1,5,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding RepeatText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
                <CheckBox Grid.Column="2"
                          Style="{DynamicResource ToggleSwitch}"
                          Margin="8,0,0,0"
                          VerticalAlignment="Center"
                          IsChecked="{Binding IsEnabled, Mode=OneWay}"
                          AutomationProperties.Name="{Binding TitleText}"
                          ToolTip="켜기/끄기"
                          Checked="ScheduleToggle_Changed"
                          Unchecked="ScheduleToggle_Changed" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CompactHistoryTemplate" DataType="{x:Type app:HistoryRow}">
            <Grid Margin="16,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource ResultBadge}" VerticalAlignment="Top" Margin="0,1,10,0">
                    <TextBlock Text="{Binding ResultText}" FontSize="12" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding DetailText}" FontSize="13" TextWrapping="Wrap" />
                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0">
                        <Run Text="{Binding TimeText, Mode=OneWay}" />
                        <Run Text=" · " />
                        <Run Text="{Binding EventText, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== Navigation pane ===================== -->
        <Border Background="{DynamicResource PaneBackgroundBrush}"
                BorderBrush="{DynamicResource DividerStrokeBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="12,18,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="8,0,0,20">
                    <Image Source="pack://application:,,,/AutoPower.App;component/Assets/eslee-auto-power.png"
                           Width="28" Height="28" Margin="0,0,10,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="eslee Auto Power" Style="{DynamicResource SubtitleText}" FontSize="17" VerticalAlignment="Center" />
                </StackPanel>

                <ListBox x:Name="Navigation"
                         Grid.Row="1"
                         Style="{DynamicResource NavList}"
                         AutomationProperties.Name="탐색"
                         SelectionChanged="Navigation_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type app:NavItem}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" FontFamily="{x:Static controls:ThemeFonts.Icons}" FontSize="16"
                                           VerticalAlignment="Center" Margin="4,0,14,0" />
                                <TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Grid.Row="3"
                        Style="{DynamicResource SubtleButton}"
                        HorizontalContentAlignment="Left"
                        Padding="14,9"
                        AutomationProperties.Name="설정"
                        Click="Settings_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static controls:Glyphs.Settings}" FontFamily="{x:Static controls:ThemeFonts.Icons}" FontSize="16"
                                   VerticalAlignment="Center" Margin="0,0,14,0" />
                        <TextBlock Text="설정" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="VersionFooter" Grid.Row="4" Style="{DynamicResource CaptionText}" Margin="14,8,0,0" />
            </Grid>
        </Border>

        <!-- ===================== Content ===================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ========== Schedules page ========== -->
            <Grid x:Name="SchedulesPage" Margin="28,20,28,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="예약" Style="{DynamicResource TitleText}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Style="{DynamicResource AccentButton}" MinHeight="34" Margin="12,0,0,0"
                            AutomationProperties.Name="새 예약" ToolTip="새 예약 (Ctrl+N)" Click="New_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Static controls:Glyphs.Add}" FontFamily="{x:Static controls:ThemeFonts.Icons}" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="새 예약" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="MoreButton" Grid.Column="2" Style="{DynamicResource IconButton}" Margin="6,0,0,0"
                            Content="{x:Static controls:Glyphs.More}" AutomationProperties.Name="더 보기" ToolTip="더 보기"
                            Click="More_Click">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="MoreMenu">
                                <MenuItem x:Name="PauseAllMenu" Header="모두 일시 중지" Click="PauseAll_Click">
                                    <MenuItem.Icon><TextBlock Text="{x:Static controls:Glyphs.Pause}" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="ResumeAllMenu" Header="모두 다시 켜기" Click="ResumeAll_Click">
                                    <MenuItem.Icon><TextBlock Text="{x:Static controls:Glyphs.Play}" /></MenuItem.Icon>
                                </MenuItem>
                                <Separator Margin="4" />
                                <MenuItem Header="새로 고침" Click="Refresh_Click">
                                    <MenuItem.Icon><TextBlock Text="{x:Static controls:Glyphs.Sync}" /></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </Grid>

                <!-- Attention: missed / failed runs since last acknowledgement -->
                <Border Grid.Row="1" Style="{DynamicResource InfoBarCaution}" Margin="0,0,0,12"
                        Visibility="{Binding HasAttention, Converter={x:Static controls:Converters.BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static controls:Glyphs.Warning}" Style="{DynamicResource IconText}"
                                   Foreground="{DynamicResource CautionForegroundBrush}" Margin="0,0,12,0" />
                        <TextBlock Grid.Column="1" Text="{Binding AttentionText}" Style="{DynamicResource BodyText}" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="기록 보기" Style="{DynamicResource LinkButton}" Margin="12,0,0,0" Click="AttentionHistory_Click" />
                        <Button Grid.Column="3" Style="{DynamicResource IconButton}" Width="28" Height="28" FontSize="12" Margin="4,0,0,0"
                                Content="{x:Static controls:Glyphs.Cancel}" AutomationProperties.Name="알림 닫기" ToolTip="알림 닫기"
                                Click="DismissAttention_Click" />
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{DynamicResource InfoBarCritical}" Margin="0,0,0,12"
                        Visibility="{Binding HasSecurityWarning, Converter={x:Static controls:Converters.BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static controls:Glyphs.Error}" Style="{DynamicResource IconText}"
                                   Foreground="{DynamicResource CriticalForegroundBrush}" Margin="0,0,12,0" />
                        <TextBlock Grid.Column="1" Text="{Binding SecurityWarning}" Style="{DynamicResource BodyText}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Next action -->
                <Border Grid.Row="3" Style="{DynamicResource Card}" Padding="20,16" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="52" Height="52" CornerRadius="26" Margin="0,0,16,0" VerticalAlignment="Center"
                                Background="{DynamicResource AccentSubtleBrush}">
                            <TextBlock Text="{Binding NextGlyph}" FontFamily="{x:Static controls:ThemeFonts.Icons}" FontSize="22"
                                       Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="다음 동작" Style="{DynamicResource CaptionText}" />
                            <TextBlock Text="{Binding NextWhenText}" Style="{DynamicResource SubtitleText}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding NextDetailText}" Style="{DynamicResource SecondaryText}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="지금 전원 상태 전환" Style="{DynamicResource CaptionText}" HorizontalAlignment="Right" Margin="0,0,0,6" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Margin="0,0,8,0" Click="EnterS3_Click" AutomationProperties.Name="지금 S3 절전"
                                        ToolTip="S3/S4 버튼을 누르면 같은 방식의 자동 시작 예약을 준비한 뒤 PC를 해당 전원 상태로 전환합니다. 예약이 없으면 바로 전환합니다.">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Static controls:Glyphs.Sleep}" FontFamily="{x:Static controls:ThemeFonts.Icons}" FontSize="14"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="S3 절전" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Click="EnterS4_Click" AutomationProperties.Name="지금 S4 최대 절전"
                                        ToolTip="S3/S4 버튼을 누르면 같은 방식의 자동 시작 예약을 준비한 뒤 PC를 해당 전원 상태로 전환합니다. 예약이 없으면 바로 전환합니다.">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Static controls:Glyphs.Hibernate}" FontFamily="{x:Static controls:ThemeFonts.Icons}" FontSize="14"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="S4 최대 절전" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- List / detail -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*" MinWidth="300" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="6*" />
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <ListBox x:Name="ScheduleList"
                                 ItemsSource="{Binding Schedules}"
                                 SelectedItem="{Binding SelectedSchedule}"
                                 ItemTemplate="{StaticResource ScheduleItemTemplate}"
                                 AutomationProperties.Name="예약 목록"
                                 MouseDoubleClick="ScheduleList_MouseDoubleClick"
                                 KeyDown="ScheduleList_KeyDown" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                                    Visibility="{Binding HasSchedules, Converter={x:Static controls:Converters.InverseBoolToVisibility}}">
                            <TextBlock Text="{x:Static controls:Glyphs.Calendar}" Style="{DynamicResource IconText}" FontSize="32"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock Text="예약이 없습니다" Style="{DynamicResource BodyStrongText}" HorizontalAlignment="Center" Margin="0,12,0,4" />
                            <TextBlock Text="새 예약으로 종료·절전·자동 시작 시각을 정하세요." Style="{DynamicResource SecondaryText}"
                                       TextAlignment="Center" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Detail -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding HasSelectedSchedule, Converter={x:Static controls:Converters.BoolToVisibility}}">
                        <StackPanel DataContext="{Binding SelectedSchedule}">
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" CornerRadius="22" Margin="0,0,14,0" Style="{StaticResource ActionIconCircle}">
                                    <TextBlock Text="{Binding ActionGlyph}" FontFamily="{x:Static controls:ThemeFonts.Icons}" FontSize="20"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TitleText}" Style="{DynamicResource SubtitleText}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding SubtitleText}" Style="{DynamicResource SecondaryText}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>

                            <WrapPanel Margin="0,0,0,14">
                                <Button Margin="0,0,8,8" Click="Edit_Click" AutomationProperties.Name="수정">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Static controls:Glyphs.Edit}" FontFamily="{x:Static controls:ThemeFonts.Icons}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="수정" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Margin="0,0,8,8" Click="Duplicate_Click" AutomationProperties.Name="복제">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Static controls:Glyphs.Copy}" FontFamily="{x:Static controls:ThemeFonts.Icons}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="복제" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Margin="0,0,8,8" Click="Delete_Click" AutomationProperties.Name="삭제">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Static controls:Glyphs.Delete}" FontFamily="{x:Static controls:ThemeFonts.Icons}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="삭제" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>

                            <TextBlock Text="세부 정보" Style="{DynamicResource SectionHeaderText}" />
                            <Border Style="{DynamicResource Card}" Padding="0" Margin="0,0,0,18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="동작" Style="{StaticResource DetailLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding ActionText}" Style="{StaticResource DetailValue}" />

                                    <Border Grid.Row="1" Style="{StaticResource RowDivider}" />
                                    <TextBlock Grid.Row="1" Text="시각" Style="{StaticResource DetailLabel}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource DetailValue}">
                                        <Run Text="{Binding LongDateText, Mode=OneWay}" />
                                        <Run Text="{Binding TimeText, Mode=OneWay}" />
                                    </TextBlock>

                                    <Border Grid.Row="2" Style="{StaticResource RowDivider}" />
                                    <TextBlock Grid.Row="2" Text="반복" Style="{StaticResource DetailLabel}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RepeatDisplayText}" Style="{StaticResource DetailValue}" />

                                    <Border Grid.Row="3" Style="{StaticResource RowDivider}" />
                                    <TextBlock Grid.Row="3" Text="상태" Style="{StaticResource DetailLabel}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource DetailValue}"
                                               Text="{Binding DataContext.SelectedStatusText, RelativeSource={RelativeSource AncestorType=Window}}" />

                                    <Border Grid.Row="4" Style="{StaticResource RowDivider}"
                                            Visibility="{Binding IsWake, Converter={x:Static controls:Converters.BoolToVisibility}}" />
                                    <TextBlock Grid.Row="4" Text="복귀 후 로그인" Style="{StaticResource DetailLabel}"
                                               Visibility="{Binding IsWake, Converter={x:Static controls:Converters.BoolToVisibility}}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SessionText}" Style="{StaticResource DetailValue}"
                                               Visibility="{Binding IsWake, Converter={x:Static controls:Converters.BoolToVisibility}}" />

                                    <Border Grid.Row="5" Style="{StaticResource RowDivider}"
                                            Visibility="{Binding IsWake, Converter={x:Static controls:Converters.BoolToVisibility}}" />
                                    <TextBlock Grid.Row="5" Text="후속 프로그램" Style="{StaticResource DetailLabel}" VerticalAlignment="Top"
                                               Visibility="{Binding IsWake, Converter={x:Static controls:Converters.BoolToVisibility}}" />
                                    <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,11,16,11"
                                                Visibility="{Binding IsWake, Converter={x:Static controls:Converters.BoolToVisibility}}">
                                        <TextBlock Text="{Binding ProgramsText}" Style="{DynamicResource BodyText}" />
                                        <ItemsControl ItemsSource="{Binding Programs}" Margin="0,4,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type app:ProgramDraft}">
                                                    <TextBlock Style="{DynamicResource CaptionText}" Margin="0,2,0,0">
                                                        <Run Text="{Binding FileName, Mode=OneWay}" FontWeight="SemiBold" />
                                                        <Run Text="{Binding DelayText, Mode=OneWay}" />
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="최근 기록" Style="{DynamicResource SectionHeaderText}" />
                                <Button Grid.Column="1" Content="모든 기록 보기" Style="{DynamicResource LinkButton}" Margin="0,0,0,6" Click="ScheduleHistory_Click" />
                            </Grid>
                            <Border Style="{DynamicResource Card}" Padding="0,4">
                                <Grid>
                                    <ItemsControl ItemsSource="{Binding DataContext.SelectedScheduleHistory, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  ItemTemplate="{StaticResource CompactHistoryTemplate}" />
                                    <TextBlock Text="아직 기록이 없습니다." Style="{DynamicResource SecondaryText}" Margin="16,10"
                                               Visibility="{Binding DataContext.SelectedScheduleHistory.Count, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static controls:Converters.ZeroToVisible}}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ========== History page ========== -->
            <Grid x:Name="HistoryPage" Margin="28,20,28,16" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="기록" Style="{DynamicResource TitleText}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Click="ClearHistory_Click" AutomationProperties.Name="전체 기록 삭제">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Static controls:Glyphs.Delete}" FontFamily="{x:Static controls:ThemeFonts.Icons}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="전체 기록 삭제" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="HistorySearchBox"
                             Style="{DynamicResource SearchBox}"
                             Tag="내용이나 구분으로 검색"
                             AutomationProperties.Name="기록 검색"
                             Text="{Binding HistorySearch, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <WrapPanel Grid.Row="2" Margin="0,0,0,8">
                    <RadioButton x:Name="FilterAll" Style="{DynamicResource ChipRadio}" GroupName="HistoryFilter" Content="전체" IsChecked="True" Checked="HistoryFilter_Checked" Tag="{x:Static app:HistoryResultFilter.All}" />
                    <RadioButton Style="{DynamicResource ChipRadio}" GroupName="HistoryFilter" Content="성공" Checked="HistoryFilter_Checked" Tag="{x:Static app:HistoryResultFilter.Success}" />
                    <RadioButton Style="{DynamicResource ChipRadio}" GroupName="HistoryFilter" Content="실패" Checked="HistoryFilter_Checked" Tag="{x:Static app:HistoryResultFilter.Failure}" />
                    <RadioButton Style="{DynamicResource ChipRadio}" GroupName="HistoryFilter" Content="건너뜀" Checked="HistoryFilter_Checked" Tag="{x:Static app:HistoryResultFilter.Skipped}" />
                    <RadioButton Style="{DynamicResource ChipRadio}" GroupName="HistoryFilter" Content="경고" Checked="HistoryFilter_Checked" Tag="{x:Static app:HistoryResultFilter.Warning}" />
                    <RadioButton Style="{DynamicResource ChipRadio}" GroupName="HistoryFilter" Content="정보" Checked="HistoryFilter_Checked" Tag="{x:Static app:HistoryResultFilter.Information}" />
                    <Border Background="{DynamicResource AccentSubtleBrush}" CornerRadius="14" Padding="10,0,2,0" Margin="8,0,0,6" Height="26"
                            Visibility="{Binding HasHistoryScheduleFilter, Converter={x:Static controls:Converters.BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding HistoryScheduleFilterText}" FontSize="13" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" />
                            <Button Style="{DynamicResource IconButton}" Width="24" Height="24" FontSize="10" Margin="4,0,0,0"
                                    Content="{x:Static controls:Glyphs.Cancel}" AutomationProperties.Name="예약 필터 해제" ToolTip="예약 필터 해제"
                                    Click="ClearHistoryScheduleFilter_Click" />
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <Border Grid.Row="3" Style="{DynamicResource Card}" Padding="0" ClipToBounds="True">
                    <Grid>
                        <DataGrid x:Name="HistoryGrid" ItemsSource="{Binding HistoryView}" AutomationProperties.Name="기록 목록">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="시각" Binding="{Binding TimeText}" Width="165" />
                                <DataGridTemplateColumn Header="결과" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ResultBadge}">
                                                <TextBlock Text="{Binding ResultText}" FontSize="12" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="구분" Binding="{Binding EventText}" Width="150" />
                                <DataGridTemplateColumn Header="내용" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DetailText}" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="조건에 맞는 기록이 없습니다." Style="{DynamicResource SecondaryText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HistoryIsEmpty, Converter={x:Static controls:Converters.BoolToVisibility}}" />
                    </Grid>
                </Border>
            </Grid>

            <!-- ========== Compatibility page ========== -->
            <ScrollViewer x:Name="CompatibilityPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="28,20,28,16">
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="호환성" Style="{DynamicResource TitleText}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Click="Diagnose_Click" AutomationProperties.Name="다시 진단">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{x:Static controls:Glyphs.Sync}" FontFamily="{x:Static controls:ThemeFonts.Icons}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="다시 진단" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Text="이 PC에서 실제로 사용할 수 있는 기능 진단" Style="{DynamicResource SecondaryText}" Margin="0,0,0,18" />

                    <ItemsControl ItemsSource="{Binding Compatibility}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type app:CompatibilityRow}">
                                <Border Style="{DynamicResource Card}" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Glyph}" Style="{DynamicResource IconText}" FontSize="20" Width="24"
                                                   VerticalAlignment="Top" Margin="0,2,16,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding CapabilityText}" Style="{DynamicResource BodyStrongText}" />
                                            <TextBlock Text="{Binding DetailText}" Style="{DynamicResource CaptionText}" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Style="{StaticResource CapabilityBadge}" Margin="16,0,0,0" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding StatusText}" FontSize="12" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="전원 자동 깨우기 실제 테스트" Style="{DynamicResource SectionHeaderText}" Margin="2,14,0,8" />
                    <Border Style="{DynamicResource Card}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource SecondaryText}"
                                       Text="자동 시작 경로인 S3 절전과 S4 최대 절전의 WakeToRun 동작을 직접 검증합니다. 버튼을 누르면 2분 뒤 임시 깨우기 예약을 만들고 PC를 실제로 해당 상태로 전환합니다." />
                            <WrapPanel Margin="0,12,0,0">
                                <Button Margin="0,0,8,0" Click="S3Test_Click" AutomationProperties.Name="S3 절전 테스트">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Static controls:Glyphs.Sleep}" FontFamily="{x:Static controls:ThemeFonts.Icons}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="S3 절전 테스트" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Click="S4Test_Click" AutomationProperties.Name="S4 최대 절전 테스트">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Static controls:Glyphs.Hibernate}" FontFamily="{x:Static controls:ThemeFonts.Icons}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="S4 최대 절전 테스트" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Status bar -->
            <Border Grid.Row="1"
                    Background="{DynamicResource PaneBackgroundBrush}"
                    BorderBrush="{DynamicResource DividerStrokeBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="28,8">
                <TextBlock Text="{Binding StatusMessage}" Style="{DynamicResource CaptionText}" />
            </Border>
        </Grid>
    </Grid>
</controls:ThemedWindow>
