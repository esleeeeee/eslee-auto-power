<Window x:Class="AutoPower.App.ExitConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="eslee Auto Power 종료" Width="470" Height="250" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="eslee Auto Power를 종료하시겠습니까?" FontSize="19" FontWeight="SemiBold"/>
        <StackPanel Grid.Row="1" Margin="0,15,0,0">
            <TextBlock Text="등록된 전원 예약은 계속 유지되지만 일부 알림과 실시간 상태 표시가 제한될 수 있습니다." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
            <CheckBox x:Name="NeverAgain" Content="다시 표시하지 않기" Margin="0,18,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="취소" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="앱 종료" Style="{StaticResource AccentButton}" Click="Exit_Click"/>
        </StackPanel>
    </Grid>
</Window>
