<controls:ThemedWindow x:Class="AutoPower.App.ExitConfirmationWindow"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:controls="clr-namespace:AutoPower.App.Controls"
                       Title="eslee Auto Power 종료"
                       Width="470"
                       SizeToContent="Height"
                       ResizeMode="NoResize"
                       WindowStartupLocation="CenterOwner"
                       ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="24,20,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static controls:Glyphs.Warning}"
                       FontFamily="{x:Static controls:ThemeFonts.Icons}"
                       FontSize="22"
                       Foreground="{DynamicResource CautionForegroundBrush}"
                       VerticalAlignment="Top"
                       Margin="0,2,14,0" />
            <StackPanel Grid.Column="1">
                <TextBlock Text="eslee Auto Power를 종료하시겠습니까?" Style="{DynamicResource SubtitleText}" FontSize="18" TextWrapping="Wrap" />
                <TextBlock Text="등록된 전원 예약은 계속 유지되지만 일부 알림과 실시간 상태 표시가 제한될 수 있습니다."
                           Style="{DynamicResource SecondaryText}" Margin="0,8,0,0" />
                <CheckBox x:Name="NeverAgain" Content="다시 표시하지 않기" Margin="0,16,0,0" />
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Style="{DynamicResource DialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="앱 종료" MinWidth="96" Style="{DynamicResource AccentButton}" Margin="0,0,8,0" Click="Exit_Click" />
                <Button Content="취소" MinWidth="96" IsCancel="True" IsDefault="True" />
            </StackPanel>
        </Border>
    </Grid>
</controls:ThemedWindow>
