<Window x:Class="AutoPower.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="eslee Auto Power 정보"
        Width="640" Height="620" MinWidth="560" MinHeight="540"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="116"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="104" Height="104" CornerRadius="22" Background="#101419"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Image Source="/AutoPower.App;component/Assets/eslee-auto-power.png"
                       Margin="5" Stretch="Uniform" SnapsToDevicePixels="True"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="18,5,0,0">
                <TextBlock Text="eslee Auto Power" FontSize="27" FontWeight="SemiBold"/>
                <TextBlock x:Name="VersionValue" Foreground="{StaticResource AccentBrush}"
                           FontSize="15" FontWeight="SemiBold" Margin="0,7,0,0"/>
                <TextBlock Text="Windows 11용 S3/S4 예약 깨우기 및 전원 자동화"
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,9,0,0"/>
                <TextBlock x:Name="UpdateStatusValue" Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" Margin="0,9,0,0"/>
                <WrapPanel Margin="0,10,0,0">
                    <Button x:Name="CheckUpdateButton" Content="업데이트 확인" Click="CheckUpdate_Click"
                            Padding="10,5" MinHeight="30" Margin="0,0,8,0"/>
                    <Button Content="Release 페이지 열기" Click="OpenReleases_Click"
                            Padding="10,5" MinHeight="30"/>
                </WrapPanel>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="9" Padding="18" Margin="0,22,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="운영 체제" Foreground="{StaticResource MutedBrush}" Margin="0,0,12,12"/>
                <TextBlock x:Name="OperatingSystemValue" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,12"/>

                <TextBlock Grid.Row="1" Text="실행 환경" Foreground="{StaticResource MutedBrush}" Margin="0,0,12,12"/>
                <TextBlock x:Name="RuntimeValue" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,12"/>

                <TextBlock Grid.Row="2" Text="앱 데이터" Foreground="{StaticResource MutedBrush}" Margin="0,0,12,12"/>
                <TextBlock x:Name="DataDirectoryValue" Grid.Row="2" Grid.Column="1"
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                <TextBlock Grid.Row="3" Text="진단 로그" Foreground="{StaticResource MutedBrush}" Margin="0,0,12,0"/>
                <TextBlock x:Name="LogDirectoryValue" Grid.Row="3" Grid.Column="1"
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Margin="0,18,0,18">
            <StackPanel>
                <TextBlock Text="개인정보 및 동작 방식" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="예약, 실행 기록과 로그인 자격 증명은 이 PC의 Windows 보호 저장소와 로컬 앱 데이터에만 보관됩니다. 앱은 외부 서버로 사용 정보를 전송하지 않습니다."
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                <TextBlock Text="S3 절전 또는 S4 최대 절전에서 예약 시각에 세션을 복귀시키며, 완전 종료(S5) 자동 부팅은 앱 제어 기능으로 제공하지 않습니다."
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                <TextBlock Text="© 2026 eslee" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="진단 로그 폴더 열기" Click="OpenLogs_Click" Margin="0,0,10,0"/>
            <Button Content="확인" Style="{StaticResource AccentButton}" IsDefault="True"
                    MinWidth="88" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
