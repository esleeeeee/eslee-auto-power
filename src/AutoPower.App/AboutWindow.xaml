<controls:ThemedWindow x:Class="AutoPower.App.AboutWindow"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:controls="clr-namespace:AutoPower.App.Controls"
                       Title="eslee Auto Power 정보"
                       Width="620"
                       Height="600"
                       MinWidth="520"
                       MinHeight="480"
                       WindowStartupLocation="CenterOwner"
                       ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,24,28,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Source="pack://application:,,,/AutoPower.App;component/Assets/eslee-auto-power.png"
                           Width="72"
                           Height="72"
                           VerticalAlignment="Top"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Grid.Column="1" Margin="18,2,0,0">
                        <TextBlock Text="eslee Auto Power" Style="{DynamicResource TitleText}" />
                        <TextBlock x:Name="VersionValue" Style="{DynamicResource BodyStrongText}" Foreground="{DynamicResource AccentTextBrush}" Margin="0,4,0,0" />
                        <TextBlock Text="Windows 11용 S3/S4 예약 깨우기 및 전원 자동화" Style="{DynamicResource SecondaryText}" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="업데이트" Style="{DynamicResource SectionHeaderText}" Margin="2,24,0,8" />
                <Border Style="{DynamicResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static controls:Glyphs.Sync}" Style="{DynamicResource IconText}" Margin="0,0,14,0" />
                        <TextBlock x:Name="UpdateStatusValue" Grid.Column="1" Style="{DynamicResource BodyText}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
                            <Button x:Name="CheckUpdateButton" Content="업데이트 확인" Click="CheckUpdate_Click" Margin="0,0,8,0" />
                            <Button Click="OpenReleases_Click" AutomationProperties.Name="Release 페이지 열기" ToolTip="Release 페이지 열기"
                                    Style="{DynamicResource IconButton}" Content="{x:Static controls:Glyphs.OpenInNew}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="실행 환경" Style="{DynamicResource SectionHeaderText}" Margin="2,20,0,8" />
                <Border Style="{DynamicResource Card}" Padding="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="운영 체제" Style="{DynamicResource SecondaryText}" Margin="16,12,12,12" />
                        <TextBlock x:Name="OperatingSystemValue" Grid.Column="1" Style="{DynamicResource BodyText}" Margin="0,12,16,12" />
                        <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="{DynamicResource DividerStrokeBrush}" BorderThickness="0,1,0,0" />
                        <TextBlock Grid.Row="1" Text="실행 환경" Style="{DynamicResource SecondaryText}" Margin="16,12,12,12" />
                        <TextBlock x:Name="RuntimeValue" Grid.Row="1" Grid.Column="1" Style="{DynamicResource BodyText}" Margin="0,12,16,12" />
                        <Border Grid.Row="2" Grid.ColumnSpan="2" BorderBrush="{DynamicResource DividerStrokeBrush}" BorderThickness="0,1,0,0" />
                        <TextBlock Grid.Row="2" Text="앱 데이터" Style="{DynamicResource SecondaryText}" Margin="16,12,12,12" />
                        <TextBlock x:Name="DataDirectoryValue" Grid.Row="2" Grid.Column="1" Style="{DynamicResource BodyText}" Margin="0,12,16,12" />
                        <Border Grid.Row="3" Grid.ColumnSpan="2" BorderBrush="{DynamicResource DividerStrokeBrush}" BorderThickness="0,1,0,0" />
                        <TextBlock Grid.Row="3" Text="진단 로그" Style="{DynamicResource SecondaryText}" Margin="16,12,12,12" />
                        <TextBlock x:Name="LogDirectoryValue" Grid.Row="3" Grid.Column="1" Style="{DynamicResource BodyText}" Margin="0,12,16,12" />
                    </Grid>
                </Border>

                <TextBlock Text="개인정보 및 동작 방식" Style="{DynamicResource SectionHeaderText}" Margin="2,20,0,8" />
                <TextBlock Style="{DynamicResource SecondaryText}"
                           Text="예약, 실행 기록과 로그인 자격 증명은 이 PC의 Windows 보호 저장소와 로컬 앱 데이터에만 보관됩니다. 앱은 외부 서버로 사용 정보를 전송하지 않습니다." />
                <TextBlock Style="{DynamicResource SecondaryText}" Margin="0,8,0,0"
                           Text="S3 절전 또는 S4 최대 절전에서 예약 시각에 세션을 복귀시키며, 완전 종료(S5) 자동 부팅은 앱 제어 기능으로 제공하지 않습니다." />
                <TextBlock Text="© 2026 eslee" Style="{DynamicResource CaptionText}" Margin="0,12,0,0" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Style="{DynamicResource DialogFooter}">
            <DockPanel>
                <Button Content="진단 로그 폴더 열기" Click="OpenLogs_Click" DockPanel.Dock="Left" HorizontalAlignment="Left" />
                <Button Content="닫기" MinWidth="96" Style="{DynamicResource AccentButton}" IsDefault="True" IsCancel="True" HorizontalAlignment="Right" Click="Close_Click" />
            </DockPanel>
        </Border>
    </Grid>
</controls:ThemedWindow>
