<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AutoPower.Core\AutoPower.Core.csproj" />
    <ProjectReference Include="..\AutoPower.Data\AutoPower.Data.csproj" />
    <ProjectReference Include="..\AutoPower.Windows\AutoPower.Windows.csproj" />
    <!-- InstallationLayout resolves AutoPower.Helper.exe and AutoPower.Agent.exe next to the
         app executable. Referencing both exe projects keeps every build output (not just the
         installer publish layout) shaped like the installed app, so schedule saves can always
         launch the elevated helper. -->
    <ProjectReference Include="..\AutoPower.Helper\AutoPower.Helper.csproj" />
    <ProjectReference Include="..\AutoPower.Agent\AutoPower.Agent.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\eslee-auto-power.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\eslee-auto-power.ico" />
    <Resource Include="Assets\eslee-auto-power.png" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AutoPower.Tests" />
  </ItemGroup>

</Project>
