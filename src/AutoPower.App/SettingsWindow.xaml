<controls:ThemedWindow x:Class="AutoPower.App.SettingsWindow"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:controls="clr-namespace:AutoPower.App.Controls"
                       Title="설정"
                       WindowStartupLocation="CenterOwner"
                       ShowInTaskbar="False"
                       Width="720"
                       Height="740"
                       MinWidth="580"
                       MinHeight="480">
    <Window.Resources>
        <Style x:Key="RowGrid" TargetType="Grid">
            <Setter Property="Margin" Value="16,12" />
            <Setter Property="MinHeight" Value="40" />
        </Style>
        <Style x:Key="RowIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{x:Static controls:ThemeFonts.Icons}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,22,28,20">
                <TextBlock Text="설정" Style="{DynamicResource TitleText}" Margin="0,0,0,18" />

                <!-- ===== Appearance ===== -->
                <TextBlock Text="화면" Style="{DynamicResource SectionHeaderText}" />
                <Border Style="{DynamicResource Card}" Padding="0" Margin="0,0,0,20">
                    <StackPanel>
                        <Grid Style="{StaticResource RowGrid}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowIcon}" Text="{x:Static controls:Glyphs.Theme}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="테마" />
                                <TextBlock Text="밝게, 어둡게, 또는 Windows 설정과 같게 표시합니다." Style="{DynamicResource CaptionText}" />
                            </StackPanel>
                            <ComboBox x:Name="ThemeChoice"
                                      Grid.Column="2"
                                      MinWidth="200"
                                      Margin="16,0,0,0"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="테마"
                                      DisplayMemberPath="Text"
                                      SelectionChanged="ThemeChoice_SelectionChanged" />
                        </Grid>
                        <Separator Margin="0" />
                        <Grid Style="{StaticResource RowGrid}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowIcon}" Text="{x:Static controls:Glyphs.Language}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="언어" />
                                <TextBlock Text="앱을 다시 시작하면 적용됩니다." Style="{DynamicResource CaptionText}" />
                            </StackPanel>
                            <ComboBox x:Name="LanguageChoice"
                                      Grid.Column="2"
                                      MinWidth="200"
                                      Margin="16,0,0,0"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="언어"
                                      DisplayMemberPath="Text"
                                      SelectionChanged="LanguageChoice_SelectionChanged" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== Behavior ===== -->
                <TextBlock Text="앱 동작" Style="{DynamicResource SectionHeaderText}" />
                <Border Style="{DynamicResource Card}" Padding="0" Margin="0,0,0,20">
                    <StackPanel>
                        <Grid Style="{StaticResource RowGrid}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowIcon}" Text="{x:Static controls:Glyphs.Power}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Windows 로그인 시 자동 실행" />
                                <TextBlock Text="창 없이 트레이로 시작합니다. 끄면 5분 전 경고, 후속 프로그램 상태 표시와 복구 기능이 제한될 수 있습니다. 등록된 전원 작업 자체는 유지됩니다."
                                           Style="{DynamicResource CaptionText}" />
                            </StackPanel>
                            <CheckBox x:Name="StartupOption"
                                      Grid.Column="2"
                                      Margin="16,0,0,0"
                                      VerticalAlignment="Center"
                                      Style="{DynamicResource ToggleSwitch}"
                                      AutomationProperties.Name="Windows 로그인 시 자동 실행"
                                      Checked="StartupOption_Changed"
                                      Unchecked="StartupOption_Changed" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== One-time sign-in ===== -->
                <TextBlock Text="S3/S4 앱 관리형 1회 자동 로그인" Style="{DynamicResource SectionHeaderText}" />
                <Border Style="{DynamicResource Card}" Padding="0" Margin="0,0,0,20">
                    <StackPanel>
                        <Grid Style="{StaticResource RowGrid}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowIcon}" Text="{x:Static controls:Glyphs.Contact}" VerticalAlignment="Top" Margin="0,2,16,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="CredentialStatusText" Text="등록 상태 확인 중…" Style="{DynamicResource BodyStrongText}" TextWrapping="Wrap" />
                                <TextBlock Style="{DynamicResource CaptionText}" Margin="0,4,0,0"
                                           Text="자동 시작 예약에서 1회 자동 로그인을 선택할 때 사용할 Windows 계정을 등록하고 실제 로그온 자격 증명을 검사합니다. PIN이 아니라 Windows 계정 암호를 입력하세요. 암호는 Windows 보호 저장소에만 보관됩니다." />
                            </StackPanel>
                        </Grid>
                        <Separator Margin="0" />
                        <StackPanel Margin="54,12,16,16">
                            <TextBlock Text="Windows 사용자 이름" Style="{DynamicResource FieldLabel}" />
                            <TextBox x:Name="CredentialUserNameInput" AutomationProperties.Name="Windows 사용자 이름" />
                            <TextBlock Text="Windows 계정 암호" Style="{DynamicResource FieldLabel}" Margin="0,12,0,6" />
                            <PasswordBox x:Name="CredentialPasswordInput" AutomationProperties.Name="Windows 계정 암호" />
                            <TextBlock Style="{DynamicResource CaptionText}" Margin="0,6,0,0"
                                       Text="Microsoft 계정은 메일 주소만 입력해도 MicrosoftAccount\메일주소 형식으로 자동 변환됩니다. 로컬 계정은 PC이름\사용자 형식이며, Windows Hello PIN은 사용할 수 없습니다." />
                            <WrapPanel Margin="0,14,0,0">
                                <Button x:Name="SaveCredentialButton" Content="저장 및 검증" Style="{DynamicResource AccentButton}" Margin="0,0,8,8" Click="SaveCredential_Click" />
                                <Button x:Name="TestCredentialButton" Content="저장된 로그인 테스트" Margin="0,0,8,8" Click="TestCredential_Click" />
                                <Button x:Name="RemoveCredentialButton" Content="등록 정보 제거" Margin="0,0,0,8" Click="RemoveCredential_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== Diagnostics and about ===== -->
                <TextBlock Text="진단 및 정보" Style="{DynamicResource SectionHeaderText}" />
                <Border Style="{DynamicResource Card}" Padding="0">
                    <StackPanel>
                        <Grid Style="{StaticResource RowGrid}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowIcon}" Text="{x:Static controls:Glyphs.Folder}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="진단 로그" />
                                <TextBlock Text="문제가 생겼을 때 원인을 확인하는 기술 로그입니다. 공개 공유 전에 경로 같은 로컬 정보를 확인하세요." Style="{DynamicResource CaptionText}" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="폴더 열기" Margin="16,0,0,0" VerticalAlignment="Center"
                                    AutomationProperties.Name="진단 로그 폴더 열기" Click="OpenLogs_Click" />
                        </Grid>
                        <Separator Margin="0" />
                        <Grid Style="{StaticResource RowGrid}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowIcon}" Text="{x:Static controls:Glyphs.Info}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="eslee Auto Power 정보" />
                                <TextBlock x:Name="VersionText" Style="{DynamicResource CaptionText}" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="정보 및 업데이트" Margin="16,0,0,0" VerticalAlignment="Center" Click="About_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Style="{DynamicResource DialogFooter}">
            <Button Content="닫기" MinWidth="120" HorizontalAlignment="Right" IsCancel="True" Click="Close_Click" />
        </Border>
    </Grid>
</controls:ThemedWindow>
